NODE_ENV=development
DEMO_MODE=false
PORT=4000
HOST=127.0.0.1
APP_ORIGINS=http://127.0.0.1:5173
DATABASE_PATH=./data/referralos.sqlite
RESUME_STORAGE_DIR=./data/private-resumes
JOB_IMPORT_STORAGE_DIR=./data/private-job-imports
SESSION_DAYS=7
# Personal domains are rejected before optional company-specific mappings.
PERSONAL_EMAIL_DOMAINS=gmail.com,googlemail.com,yahoo.com,yahoo.co.uk,outlook.com,hotmail.com,live.com,msn.com,icloud.com,me.com,aol.com,proton.me,protonmail.com,gmx.com,mail.com,yandex.com
# Optional JSON object mapping exact company names to allowed domains.
COMPANY_DOMAIN_MAPPINGS={}
EMAIL_VERIFICATION_MINUTES=30
PUBLIC_APP_URL=http://127.0.0.1:5173
# Local-only link preview in development. Production must use resend.
EMAIL_PROVIDER=console
EMAIL_FROM=
RESEND_API_KEY=
# Optional OCR.space endpoint. The server sends multipart/form-data and places the key in the `apikey` header.
# OCR.space returns recognized text; it does not structure job fields. The employee must consent and review it.
# Public read-only pilot: set DEMO_MODE=true. Demo mode keeps login/logout, but blocks registration, writes, OCR, and private files.
# Example URL: https://api.ocr.space/parse/image
SCREENSHOT_OCR_URL=
SCREENSHOT_OCR_API_KEY=
