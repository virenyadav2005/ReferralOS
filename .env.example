NODE_ENV=development
# Set this explicitly to false for a live production service. Set true only for a read-only pilot.
DEMO_MODE=false
PORT=4000
# Local development binds to loopback. Hosting platforms should use 0.0.0.0; Railway supplies PORT.
HOST=127.0.0.1
APP_ORIGINS=http://127.0.0.1:5173
# For production, mount a persistent Railway volume at /data before first boot, then point all three
# paths below into that volume. Keep these directories outside apps/web/dist and any static root.
DATABASE_PATH=./data/referralos.sqlite
RESUME_STORAGE_DIR=./data/private-resumes
JOB_IMPORT_STORAGE_DIR=./data/private-job-imports
SESSION_DAYS=7
# Personal domains are rejected before optional company-specific mappings.
PERSONAL_EMAIL_DOMAINS=gmail.com,googlemail.com,yahoo.com,yahoo.co.uk,outlook.com,hotmail.com,live.com,msn.com,icloud.com,me.com,aol.com,proton.me,protonmail.com,gmx.com,mail.com,yandex.com
# Optional JSON object mapping exact company names to allowed domains.
COMPANY_DOMAIN_MAPPINGS={}
EMAIL_VERIFICATION_MINUTES=30
PUBLIC_APP_URL=http://127.0.0.1:5173
# Local-only link preview in development. Production must use resend.
EMAIL_PROVIDER=console
EMAIL_FROM=
RESEND_API_KEY=
# Optional production OCR.space configuration. Add the key only in server-side deployment secrets.
SCREENSHOT_OCR_URL=https://api.ocr.space/parse/image
# Optional OCR.space endpoint. The server sends multipart/form-data and places the key in the `apikey` header.
# OCR.space returns recognized text; it does not structure job fields. The employee must consent and review it.
# Read-only pilot only: set DEMO_MODE=true. Production user workflows require DEMO_MODE=false.
SCREENSHOT_OCR_API_KEY=

# Railway production values (set in Railway variables, not in a committed .env file):
# NODE_ENV=production
# DEMO_MODE=false
# HOST=0.0.0.0
# PORT=<provided by Railway>
# APP_ORIGINS=https://<your-final-hostname>
# PUBLIC_APP_URL=https://<your-final-hostname>
# DATABASE_PATH=/data/referralos.sqlite
# RESUME_STORAGE_DIR=/data/private-resumes
# JOB_IMPORT_STORAGE_DIR=/data/private-job-imports
# EMAIL_PROVIDER=resend                 # required only for work-email verification delivery
# EMAIL_FROM=<verified sender address>  # no reset-password email flow is implemented
# RESEND_API_KEY=<Railway secret>
# SCREENSHOT_OCR_URL=https://api.ocr.space/parse/image
# SCREENSHOT_OCR_API_KEY=<Railway secret>
